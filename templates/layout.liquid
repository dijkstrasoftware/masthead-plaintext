<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ site.title | default: site.name | escape }}</title>
    {% if site.description != "" %}<meta name="description" content="{{ site.description | escape }}" />{% endif %}
  </head>
  <body>
    <main style="padding: {{ theme.tokens.padding }}; max-width: {{ theme.tokens.max_width }}; text-align: {{ theme.tokens.justification }}">{{ content }}</main>
  </body>
</html>
